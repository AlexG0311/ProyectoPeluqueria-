<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Proyecto.Maestro"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Maestro"
    BackgroundColor="#0A0A0A">

    <ContentPage.Content>

        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="CenterAndExpand">

            <!-- PERFIL -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="10">

                <!-- AVATAR -->
                <Frame
                    Padding="5"
                    BackgroundColor="#1C1C1C"
                    BorderColor="#D4AF37"
                    CornerRadius="60"
                    HasShadow="False"
                    HeightRequest="120"
                    WidthRequest="120">

                    <Image
                        Aspect="AspectFill"
                        HeightRequest="110"
                        Source="perfil.png"
                        WidthRequest="110" />
                </Frame>

                <!-- TITULOS -->
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Text="¡Hola!"
                    TextColor="White" />

                <Label
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    Text="¿Qué deseas hacer hoy?"
                    TextColor="#B0B0B0" />
            </VerticalStackLayout>

    
            <!-- INICIO -->
            <Frame
                Margin="0"
                Padding="0"
                BackgroundColor="#151515"
                CornerRadius="25"
                HasShadow="False">

                <Button
                    BackgroundColor="Transparent"
                    CornerRadius="25"
                    FontSize="18"
                    HeightRequest="60"
                    Text="Inicio"
                    Clicked="IrInicio"
                    TextColor="#D4AF37" />
            </Frame>

            <!-- CARRITO -->
            <Frame
                Margin="0"
                Padding="0"
                BackgroundColor="#151515"
                CornerRadius="25"
                HasShadow="False">

                <Button
                    BackgroundColor="Transparent"
                    CornerRadius="25"
                    FontSize="18"
                    HeightRequest="60"
                    Text="Carrito"
                    Clicked="IrCarrito"
                    TextColor="#D4AF37" />
            </Frame>

            <!-- COMPRAS -->
            <Frame
                Margin="0"
                Padding="0"
                BackgroundColor="#151515"
                CornerRadius="25"
                HasShadow="False">

                <Button
                    BackgroundColor="Transparent"
                    CornerRadius="25"
                    FontSize="18"
                    HeightRequest="60"
                    Text="Compras"
                    TextColor="#D4AF37" />
            </Frame>

            <!-- PERFIL -->
            <Frame
                Margin="0"
                Padding="0"
                BackgroundColor="#151515"
                CornerRadius="25"
                HasShadow="False">

                <Button
                    BackgroundColor="Transparent"
                    CornerRadius="25"
                    FontSize="18"
                    HeightRequest="60"
                    Text="Perfil"
                    Clicked="IrPerfil"
                    TextColor="#D4AF37" />
            </Frame>

        </VerticalStackLayout>

    </ContentPage.Content>

</ContentPage>