<ContentPage
    x:Class="Proyecto.Detalle"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#121212"
    NavigationPage.HasNavigationBar="True">
    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="12">

            <!--  Banner con barra de búsqueda y carrito  -->
            <Grid Padding="0">
                <Image
                    Grid.RowSpan="2"
                    Aspect="AspectFill"
                    HeightRequest="170"
                    HorizontalOptions="FillAndExpand"
                    Opacity="0.15"
                    Source="banner.jpg"
                    VerticalOptions="FillAndExpand"
                    WidthRequest="450" />

                <Grid Padding="16" BackgroundColor="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Frame
                        x:Name="CarritoFrame"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        Padding="10"
                        BackgroundColor="#1E1E1E"
                        BorderColor="#2F2F2F"
                        CornerRadius="22"
                        HasShadow="False"
                        HeightRequest="44"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        WidthRequest="44">
                        <Grid>
                            <Image
                                HeightRequest="22"
                                Source="carrito.png"
                                WidthRequest="22">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCartTapped" />
                                </Image.GestureRecognizers>
                            </Image>

                            <Label
                                Margin="8,-8,0,0"
                                FontAttributes="Bold"
                                FontSize="12"
                                HeightRequest="16"
                                HorizontalOptions="End"
                                IsVisible="{Binding TotalProductosCarrito, Converter={StaticResource GreaterThanZeroConverter}}"
                                Text="{Binding TotalProductosCarrito}"
                                TextColor="#FF6B6B"
                                VerticalOptions="Start"
                                VerticalTextAlignment="Center"
                                WidthRequest="16" />
                        </Grid>
                    </Frame>

                </Grid>
            </Grid>

            <Grid Padding="20,6,20,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    HorizontalOptions="StartAndExpand"
                    Text="Servicios"
                    TextColor="#F3F3F3" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="Ver todo"
                    TextColor="#9E9E9E"
                    VerticalTextAlignment="End">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="VerMaServicios" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <CollectionView
                x:Name="ColleccionServicio"
                Margin="14,0,0,6"
                ItemsLayout="HorizontalList"
                ItemsSource="{Binding Servicios}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="5"
                            Padding="8"
                            BackgroundColor="#1B1B1B"
                            BorderColor="#2B2B2B"
                            CornerRadius="12"
                            HasShadow="False"
                            HeightRequest="220"
                            WidthRequest="160">
                            <VerticalStackLayout>
                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="130"
                                    Source="{Binding Img}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding Nombre}"
                                    TextColor="#F3F3F3" />
                                <Label
                                    FontSize="13"
                                    Text="{Binding Precio, StringFormat='Precio: ${0:F2}'}"
                                    TextColor="#A0A0A0" />
                            </VerticalStackLayout>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrServicio" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Padding="20,6,20,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    HorizontalOptions="StartAndExpand"
                    Text="Productos"
                    TextColor="#F3F3F3" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="Ver todo"
                    TextColor="#9E9E9E"
                    VerticalTextAlignment="End">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="VerMasProductos" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <CollectionView
                x:Name="ProductosInicio"
                Margin="12,0,12,10"
                ItemsLayout="VerticalGrid, 2"
                ItemsSource="{Binding Productos}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="5"
                            Padding="8"
                            BackgroundColor="#1B1B1B"
                            BorderColor="#2B2B2B"
                            CornerRadius="12"
                            HasShadow="False"
                            HeightRequest="230"
                            WidthRequest="160">
                            <VerticalStackLayout>
                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="130"
                                    Source="{Binding Img}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="{Binding Nombre}"
                                    TextColor="#F3F3F3" />
                                <Label
                                    FontSize="13"
                                    Text="{Binding Precio, StringFormat='Precio: ${0:F2}'}"
                                    TextColor="#A0A0A0" />
                                <Button
                                    Margin="0,6,0,0"
                                    BackgroundColor="#262626"
                                    BorderColor="#3A3A3A"
                                    BorderWidth="1"
                                    Clicked="AgregarAlCarrito"
                                    CommandParameter="{Binding}"
                                    CornerRadius="10"
                                    FontSize="13"
                                    HeightRequest="36"
                                    Text="Añadir"
                                    TextColor="#EAEAEA" />

                            </VerticalStackLayout>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrProductos" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
