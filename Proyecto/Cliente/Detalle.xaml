<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Proyecto.Detalle"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0A0A0A"
    NavigationPage.HasNavigationBar="True">

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="14">

            <!-- BANNER -->
            <Grid Padding="0">
                <Image
                    Aspect="AspectFill"
                    HeightRequest="170"
                    Opacity="0.25"
                    Source="banner.jpg" />

                <!-- overlay elegante -->
                <BoxView BackgroundColor="#000000" Opacity="0.45"/>

                <Grid Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- TEXTO -->
                    <VerticalStackLayout VerticalOptions="End">
                        <Label Text="Barber Shop"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <BoxView HeightRequest="3"
                                 WidthRequest="50"
                                 BackgroundColor="#D4AF37"/>
                    </VerticalStackLayout>

                    <!-- CARRITO -->
                    <Frame
                        x:Name="CarritoFrame"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        Padding="10"
                        BackgroundColor="#151515"
                        BorderColor="#2A2A2A"
                        CornerRadius="22"
                        HasShadow="False"
                        HeightRequest="44"
                        WidthRequest="44">

                        <Grid>
                            <Image
                                HeightRequest="22"
                                Source="carrito.png"
                                WidthRequest="22">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCartTapped" />
                                </Image.GestureRecognizers>
                            </Image>

                            <Label
                                Margin="8,-8,0,0"
                                FontAttributes="Bold"
                                FontSize="11"
                                Text="{Binding TotalProductosCarrito}"
                                TextColor="#D4AF37"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                IsVisible="{Binding TotalProductosCarrito, Converter={StaticResource GreaterThanZeroConverter}}" />
                        </Grid>
                    </Frame>

                </Grid>
            </Grid>

            <!-- SERVICIOS -->
            <Grid Padding="20,6,20,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Servicios"
                    TextColor="White" />

                <Label
                    Grid.Column="1"
                    FontSize="13"
                    Text="Ver todo"
                    TextColor="#D4AF37">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="VerMaServicios" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- SERVICIOS LISTA -->
            <CollectionView
                x:Name="ColleccionServicio"
                Margin="14,0,0,6"
                ItemsLayout="HorizontalList"
                ItemsSource="{Binding Servicios}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="6"
                            Padding="0"
                            BackgroundColor="#151515"
                            BorderColor="#222"
                            CornerRadius="16"
                            HasShadow="False"
                            HeightRequest="220"
                            WidthRequest="160">

                            <VerticalStackLayout>

                                <Frame Padding="0"
                                       CornerRadius="16"
                                       IsClippedToBounds="True"
                                       HeightRequest="130">

                                    <Image
                                        Source="{Binding Img}"
                                        Aspect="AspectFill"/>
                                </Frame>

                                <VerticalStackLayout Padding="10">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding Nombre}"
                                        TextColor="White" />

                                    <Label
                                        FontSize="14"
                                        Text="{Binding Precio, StringFormat='$ {0:F0}'}"
                                        TextColor="#D4AF37" />

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrServicio" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- PRODUCTOS -->
            <Grid Padding="20,6,20,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Productos"
                    TextColor="White" />

                <Label
                    Grid.Column="1"
                    FontSize="13"
                    Text="Ver todo"
                    TextColor="#D4AF37">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="VerMasProductos" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- PRODUCTOS GRID -->
            <CollectionView
                x:Name="ProductosInicio"
                Margin="12,0,12,10"
                ItemsLayout="VerticalGrid, 2"
                ItemsSource="{Binding Productos}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="6"
                            Padding="0"
                            BackgroundColor="#151515"
                            BorderColor="#222"
                            CornerRadius="16"
                            HasShadow="False"
                            HeightRequest="240">

                            <VerticalStackLayout>

                                <Frame Padding="0"
                                       CornerRadius="16"
                                       IsClippedToBounds="True"
                                       HeightRequest="130">

                                    <Image
                                        Source="{Binding Img}"
                                        Aspect="AspectFill"/>
                                </Frame>

                                <VerticalStackLayout Padding="10">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="{Binding Nombre}"
                                        TextColor="White" />

                                    <Label
                                        FontSize="14"
                                        Text="{Binding Precio, StringFormat='$ {0:F0}'}"
                                        TextColor="#D4AF37" />

                                    <Button
                                        Margin="0,6,0,0"
                                        BackgroundColor="#D4AF37"
                                        TextColor="Black"
                                        CornerRadius="10"
                                        HeightRequest="38"
                                        Text="Añadir"
                                        Clicked="AgregarAlCarrito"
                                        CommandParameter="{Binding}" />

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrProductos" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>