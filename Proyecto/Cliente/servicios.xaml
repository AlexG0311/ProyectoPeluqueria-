<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Proyecto.Servicios"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0B0B0B">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0B0B0B" Offset="0"/>
                <GradientStop Color="#151515" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>

            <VerticalStackLayout Padding="20" Spacing="18">

               
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nuestros Servicios"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Elige el servicio que necesitas"
                           FontSize="13"
                           TextColor="#9A9A9A"/>

                    <BoxView HeightRequest="3"
                             WidthRequest="70"
                             BackgroundColor="#D4AF37"
                             HorizontalOptions="Start"/>
                </VerticalStackLayout>


                <CollectionView
                    x:Name="CollectionViewIndividuales"
                    ItemsSource="{Binding ServiciosMostrados}"
                    ItemsLayout="VerticalGrid, 2"
                    SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                          
                            <Frame
                                Margin="6"
                                Padding="0"
                                CornerRadius="22"
                                HasShadow="False"
                                BackgroundColor="#1A1A1A">

                                <VerticalStackLayout Spacing="0">


                                    <Grid HeightRequest="150">

                                        <Image Source="{Binding Img}"
                                               Aspect="AspectFill"/>

                                        <BoxView BackgroundColor="#000000"
                                                 Opacity="0.25"/>

                                    </Grid>

                             
                                    <VerticalStackLayout Padding="12" Spacing="6">

                                       
                                        <Label Text="{Binding Nombre}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               LineBreakMode="TailTruncation"/>

                                 
                                        <Label Text="{Binding Precio, StringFormat='${0:F2}'}"
                                               FontSize="14"
                                               TextColor="#D4AF37"
                                               FontAttributes="Bold"/>


                                        <Frame BackgroundColor="#D4AF37"
                                               CornerRadius="12"
                                               Padding="0"
                                               HeightRequest="36"
                                               HasShadow="False">

                                            <Label Text="Reservar"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="Black"
                                                   FontAttributes="Bold"
                                                   FontSize="13"/>
                                        </Frame>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </Frame>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>