<ContentPage
    x:Class="Proyecto.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0F0F0F"
    NavigationPage.HasNavigationBar="False">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0F0F0F" Offset="0"/>
                <GradientStop Color="#1C1C1C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20">

                
                <Image 
                    Source="logo_barber.png"
                    HeightRequest="80"
                    HorizontalOptions="Center"
                    Margin="0,10,0,5"/>

    
                <Label
                    Text="Crear cuenta"
                    FontSize="26"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="#D4AF37" />

                <Label
                    Text="Regístrate para disfrutar de nuestros servicios"
                    FontSize="13"
                    HorizontalOptions="Center"
                    TextColor="#BBBBBB" />

                <Frame
                    BackgroundColor="#1A1A1A"
                    BorderColor="#2A2A2A"
                    CornerRadius="25"
                    Padding="25"
                    HasShadow="True">

                    <VerticalStackLayout Spacing="15">

                       
                        <Frame BackgroundColor="#262626" CornerRadius="12" Padding="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label  FontSize="18" VerticalOptions="Center"/>
                                <Entry
                                    x:Name="NombreEntry"
                                    Grid.Column="1"
                                    Placeholder="Nombre"
                                    PlaceholderColor="#888"
                                    TextColor="White"
                                    BackgroundColor="Transparent"/>
                            </Grid>
                        </Frame>


                        <Frame BackgroundColor="#262626" CornerRadius="12" Padding="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label  FontSize="18" VerticalOptions="Center"/>
                                <Entry
                                    x:Name="ApellidosEntry"
                                    Grid.Column="1"
                                    Placeholder="Apellidos"
                                    PlaceholderColor="#888"
                                    TextColor="White"
                                    BackgroundColor="Transparent"/>
                            </Grid>
                        </Frame>

                  
                        <Frame BackgroundColor="#262626" CornerRadius="12" Padding="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label  FontSize="18" VerticalOptions="Center"/>
                                <Entry
                                    x:Name="CorreoEntry"
                                    Grid.Column="1"
                                    Keyboard="Email"
                                    Placeholder="Correo electrónico"
                                    PlaceholderColor="#888"
                                    TextColor="White"
                                    BackgroundColor="Transparent"/>
                            </Grid>
                        </Frame>


                        <Frame BackgroundColor="#262626" CornerRadius="12" Padding="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label FontSize="18" VerticalOptions="Center"/>
                                <Entry
                                    x:Name="PasswordEntry"
                                    Grid.Column="1"
                                    IsPassword="True"
                                    Placeholder="Contraseña"
                                    PlaceholderColor="#888"
                                    TextColor="White"
                                    BackgroundColor="Transparent"/>
                            </Grid>
                        </Frame>

                  
                        <Frame BackgroundColor="#262626" CornerRadius="12" Padding="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label FontSize="18" VerticalOptions="Center"/>
                                <Entry
                                    x:Name="TelefonoEntry"
                                    Grid.Column="1"
                                    Keyboard="Telephone"
                                    Placeholder="Teléfono"
                                    PlaceholderColor="#888"
                                    TextColor="White"
                                    BackgroundColor="Transparent"/>
                            </Grid>
                        </Frame>


                        <Button
                            Text="Registrarse"
                            Clicked="Insertar"
                            BackgroundColor="#D4AF37"
                            TextColor="Black"
                            FontAttributes="Bold"
                            CornerRadius="15"
                            HeightRequest="52"
                            Margin="0,10,0,0"/>

                    </VerticalStackLayout>
                </Frame>


                <Label HorizontalOptions="Center" FontSize="13">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="¿Ya tienes cuenta? " TextColor="#AAA"/>
                            <Span Text="Inicia sesión"
                                  TextColor="#D4AF37"
                                  FontAttributes="Bold"/>
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoginTapped"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>