<ContentPage
    x:Class="Proyecto.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#121212"
    NavigationPage.HasNavigationBar="False">

    <Grid Padding="24">
        <Frame
            Padding="24"
            BackgroundColor="#1B1B1B"
            BorderColor="#2D2D2D"
            CornerRadius="18"
            HasShadow="False"
            WidthRequest="400"
            VerticalOptions="Center"
            HorizontalOptions="Center">

            <VerticalStackLayout Spacing="26">
                <Label
                    FontAttributes="Bold"
                    FontSize="30"
                    HorizontalOptions="Center"
                    Text="Iniciar sesión"
                    TextColor="#F3F3F3" />

                <Label
                    FontSize="13"
                    HorizontalOptions="Center"
                    Text="Bienvenido de nuevo"
                    TextColor="#9E9E9E" />

                <Frame
                    Padding="12,8"
                    BackgroundColor="#242424"
                    BorderColor="#333333"
                    CornerRadius="12"
                    HasShadow="False"
                    HeightRequest="62">
                    <Entry
                        x:Name="CorreoEntry"
                        FontSize="15"
                        BackgroundColor="Transparent"
                        Placeholder="Correo electrónico"
                        PlaceholderColor="#7D7D7D"
                        TextColor="#F0F0F0" />
                </Frame>

                <Frame
                    Padding="12,8"
                    BackgroundColor="#242424"
                    BorderColor="#333333"
                    CornerRadius="12"
                    HasShadow="False"
                    HeightRequest="62"
                    >
                    <Entry
                        x:Name="PasswordEntry"
                        FontSize="15"
                        IsPassword="True"
                        BackgroundColor="Transparent"
                        Placeholder="Contraseña"
                        PlaceholderColor="#7D7D7D"
                        TextColor="#F0F0F0" />
                </Frame>

                <Button
                    Margin="0,8,0,0"
                    BackgroundColor="#EAEAEA"
                    Clicked="Login"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    Text="Entrar"
                    TextColor="#121212" />

                <Label
                    FontAttributes="Bold"
                    FontSize="13"
                    HorizontalOptions="Center"
                    Text="¿No tienes cuenta? Registrarse"
                    TextColor="#9E9E9E">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Registrar" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
