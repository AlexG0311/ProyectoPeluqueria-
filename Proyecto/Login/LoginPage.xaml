<ContentPage 
    x:Class="Proyecto.LoginPage" 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
    BackgroundColor="#0F0F0F" 
    NavigationPage.HasNavigationBar="False">

    <Grid>

      
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0F0F0F" Offset="0"/>
                <GradientStop Color="#1C1C1C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20">

             
                <Image 
                    Source="logo_barber.png"
                    HeightRequest="90"
                    HorizontalOptions="Center"
                    Margin="0,10,0,5"/>

                <Label 
                    Text="BARBER SHOP" 
                    FontSize="28" 
                    FontAttributes="Bold" 
                    HorizontalOptions="Center" 
                    TextColor="#D4AF37" />

                <Label 
                    Text="Iniciar sesión" 
                    FontSize="22" 
                    FontAttributes="Bold" 
                    HorizontalOptions="Center" 
                    TextColor="White" />

                <Label 
                    Text="Bienvenido de nuevo" 
                    FontSize="13" 
                    HorizontalOptions="Center" 
                    TextColor="#AAAAAA" />

           
                <Frame 
                    BackgroundColor="#1A1A1A" 
                    BorderColor="#2A2A2A" 
                    CornerRadius="20" 
                    Padding="25" 
                    HasShadow="True">

                    <VerticalStackLayout Spacing="18">

                   
                        <Frame BackgroundColor="#262626" CornerRadius="12" Padding="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label FontSize="18" VerticalOptions="Center"/>
                                <Entry 
                                    x:Name="CorreoEntry" 
                                    Grid.Column="1" 
                                    Placeholder="Correo electrónico" 
                                    PlaceholderColor="#888" 
                                    TextColor="White" 
                                    BackgroundColor="Transparent"/>
                            </Grid>
                        </Frame>

                      
                        <Frame BackgroundColor="#262626" CornerRadius="12" Padding="10">
                            <Grid ColumnDefinitions="Auto,*">
                               <Label FontSize="18" VerticalOptions="Center"/>
                                <Entry 
                                    x:Name="PasswordEntry" 
                                    Grid.Column="1" 
                                    IsPassword="True" 
                                    Placeholder="Contraseña" 
                                    PlaceholderColor="#888" 
                                    TextColor="White" 
                                    BackgroundColor="Transparent"/>
                            </Grid>
                        </Frame>

                     
                        <Button 
                            Text="Entrar" 
                            Clicked="Login" 
                            BackgroundColor="#D4AF37" 
                            TextColor="Black" 
                            FontAttributes="Bold" 
                            CornerRadius="12" 
                            HeightRequest="50" 
                            Margin="0,10,0,0"/>

                    </VerticalStackLayout>
                </Frame>

         
                <Label HorizontalOptions="Center" FontSize="13">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="¿No tienes cuenta? " TextColor="#AAA"/>
                            <Span Text="Regístrate" TextColor="#D4AF37" FontAttributes="Bold"/>
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Registrar"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>